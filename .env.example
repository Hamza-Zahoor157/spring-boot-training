# OAuth2 Credentials - copy to .env and fill in your real values
# See https://github.com/spring-projects/spring-authorization-server for setup instructions

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# GitHub OAuth2
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# JWT Secret
JWT_SECRET=your-jwt-secret-key

# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Database
DB_URL=jdbc:postgresql://localhost:5432/ragdb
DB_USERNAME=123
DB_PASSWORD=123
